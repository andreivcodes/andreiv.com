---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { ArrowRight } from "lucide-react";

const links = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];
---

<BaseLayout
  title="Page not found - Andrei Voinea"
  description="The page you were looking for does not exist."
  ogImage="/og-image.png"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <div class="flex min-h-screen flex-col">
    <Header />
    <main id="main-content" class="bg-background flex flex-1 items-center">
      <div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 lg:px-8">
        <p class="text-muted-foreground mb-4 font-mono text-sm">404</p>
        <h1 class="mb-4 text-4xl font-bold md:text-5xl">Page not found</h1>
        <p class="text-muted-foreground mb-10 text-lg">This page does not exist or has moved.</p>
        <ul
          class="flex list-none flex-wrap items-center justify-center gap-x-8 gap-y-4 font-mono text-sm"
        >
          {
            links.map((link) => (
              <li class="m-0 list-none p-0">
                <a
                  href={link.href}
                  class="site-emphasis-link group/link inline-flex items-center gap-1.5"
                >
                  <span>{link.label}</span>
                  <ArrowRight className="h-4 w-4 transition-transform duration-200 group-hover/link:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
